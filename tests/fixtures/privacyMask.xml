<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic, not captured: a camera with fixed mask slots (hikvision.com namespace, maskType on each slot, an unused slot 2 without coordinates), for reading slots and for the single-PUT save that firmware without DELETE gets. The DS-7604NI is different: it has no maskType, stores only the regions sent, and reads every region back with enabled false (see privacyMask-nvr-regions.xml). -->
<PrivacyMask version="2.0" xmlns="http://www.hikvision.com/ver20/XMLSchema">
<enabled>true</enabled>
<normalizedScreenSize><normalizedScreenWidth>704</normalizedScreenWidth><normalizedScreenHeight>576</normalizedScreenHeight></normalizedScreenSize>
<PrivacyMaskRegionList>
<PrivacyMaskRegion>
<id>1</id>
<enabled>true</enabled>
<RegionCoordinatesList>
<RegionCoordinates><positionX>10</positionX><positionY>20</positionY></RegionCoordinates>
<RegionCoordinates><positionX>110</positionX><positionY>20</positionY></RegionCoordinates>
<RegionCoordinates><positionX>110</positionX><positionY>120</positionY></RegionCoordinates>
<RegionCoordinates><positionX>10</positionX><positionY>120</positionY></RegionCoordinates>
</RegionCoordinatesList>
<maskType>gray</maskType>
</PrivacyMaskRegion>
<PrivacyMaskRegion>
<id>2</id>
<enabled>false</enabled>
<RegionCoordinatesList></RegionCoordinatesList>
<maskType>gray</maskType>
</PrivacyMaskRegion>
</PrivacyMaskRegionList>
</PrivacyMask>
