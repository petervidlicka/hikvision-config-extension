{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "NVR Config Tool",
  "description": "View live feeds and configure motion detection, privacy masks and event actions on Hikvision NVRs and cameras. Unofficial.",
  "version": "1.11.0",
  "permissions": ["storage"],
  "optional_host_permissions": ["http://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
