{
  "name": "hikvision-config-extension",
  "version": "1.10.0",
  "private": true,
  "description": "Chrome extension for configuring Hikvision NVRs and cameras over ISAPI",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test",
    "harness": "vite --port 8765 --strictPort --open /tests/harness/"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
